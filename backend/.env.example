# Copy to .env for local runs (never commit .env). On Render, set these in the dashboard instead.

# Browser origin(s) allowed to call the API, comma-separated. Use the deployed frontend URL in production.
GRID_CORS_ORIGINS=http://localhost:5173

# Optional overrides (defaults shown)
# GRID_DEFAULT_CUTOFF=09:20
# GRID_ACTUALS_LAG_MINUTES=0
# GRID_DATA_DIR=./data
