# Copy to .env.local (git-ignored) for local overrides. In production these are set on the host's dashboard.

# Public URL of the deployed API (Render). Read at BUILD time, so set it before `npm run build`.
# Leave unset in local dev: the default "/api" goes through the dev proxy below.
# VITE_API_BASE=https://wind-forecast-api.onrender.com

# Dev only: where the dev server proxies /api to.
API_URL=http://localhost:8000
